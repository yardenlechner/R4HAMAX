//R4HAMAX JOB (ACCT),'R4HA PEAK',CLASS=A,MSGCLASS=X,
//             NOTIFY=&SYSUID
//* Replace YOURHLQ and the input dump name before submission.
//RUN      EXEC PGM=IKJEFT01,REGION=64M,DYNAMNBR=20
//SYSEXEC  DD DISP=SHR,DSN=YOURHLQ.REXX
//SMFIN    DD DISP=SHR,DSN=YOURHLQ.SMF.DUMP
//REPORT   DD SYSOUT=*,DCB=(RECFM=VB,LRECL=260,BLKSIZE=0)
//CSVOUT   DD SYSOUT=*,DCB=(RECFM=VB,LRECL=260,BLKSIZE=0)
//SYSTSPRT DD SYSOUT=*
//SYSTSIN  DD *
 %R4HAMAX DATE=2026251 SID=* TOP=10 DAYMODE=END +
   HOURLY=Y CSV=Y DEBUG=N
