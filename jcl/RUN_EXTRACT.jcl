//R4HADMP JOB (ACCT),'EXTRACT R4HA',CLASS=A,MSGCLASS=X,
//             NOTIFY=&SYSUID
//* DUMP only: never CLEAR, DELETE or ARCHIVE the source.
//* Broad example extraction includes a day on either side.
//* Adjust BOTH extraction dates and the REXX DATE below.
//EXTRACT  EXEC PGM=IFASMFDP,REGION=64M
//DUMPIN   DD DISP=SHR,DSN=YOURHLQ.SMF.ARCHIVE
//SMFOUT   DD DSN=&&SMF70,DISP=(NEW,PASS,DELETE),UNIT=SYSDA,
//            SPACE=(CYL,(20,10),RLSE),
//            DCB=(RECFM=VBS,LRECL=32760,BLKSIZE=0)
//SYSPRINT DD SYSOUT=*
//SYSIN    DD *
 INDD(DUMPIN,OPTIONS(DUMP))
 OUTDD(SMFOUT,TYPE(70(1)))
 DATE(2026250,2026252)
 START(0000)
 END(2400)
/*
//GOOD     IF (EXTRACT.RC = 0) THEN
//RUN      EXEC PGM=IKJEFT1B,REGION=64M,DYNAMNBR=20
//SYSEXEC  DD DISP=SHR,DSN=YOURHLQ.REXX
//SMFIN    DD DSN=&&SMF70,DISP=(OLD,DELETE)
//REPORT   DD SYSOUT=*,DCB=(RECFM=VB,LRECL=260,BLKSIZE=0)
//CSVOUT   DD SYSOUT=*,DCB=(RECFM=VB,LRECL=260,BLKSIZE=0)
//SYSTSPRT DD SYSOUT=*
//SYSTSIN  DD *
 %R4HAMAX DATE=2026251 SID=* TOP=10 DAYMODE=END +
   HOURLY=Y CSV=Y DEBUG=N
/*
//         ENDIF
